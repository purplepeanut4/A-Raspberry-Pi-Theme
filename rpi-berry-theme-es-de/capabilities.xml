<?xml version="1.0" encoding="UTF-8"?>
<!-- Theme capabilities for rpi-berry-theme-es-de.
     ES-DE will NOT load a theme without this file.
     Anything listed here shows up in ES-DE's  Menu > UI Settings. -->
<themeCapabilities>
    <themeName>Raspberry Circuit</themeName>

    <!-- Pick an accent colour: UI Settings > Theme color scheme -->
    <colorScheme name="raspberry">
        <label>Raspberry red</label>
    </colorScheme>
    <colorScheme name="leaf">
        <label>Leaf green</label>
    </colorScheme>

    <!-- Background: UI Settings > Theme variant.  If it lags, pick "Still background". -->
    <variant name="animated">
        <label>Animated main screen, product photo per console</label>
        <selectable>true</selectable>
    </variant>
    <variant name="animatedAll">
        <label>Animated everywhere, product video per console (heavier)</label>
        <selectable>true</selectable>
    </variant>
    <variant name="still">
        <label>Still backgrounds (fastest)</label>
        <selectable>true</selectable>
    </variant>

    <!-- Animated screen changes: UI Settings > Theme transitions -->
    <transitions name="berryFade">
        <label>berry fade</label>
        <selectable>true</selectable>
        <systemToSystem>instant</systemToSystem>
        <systemToGamelist>fade</systemToGamelist>
        <gamelistToGamelist>instant</gamelistToGamelist>
        <gamelistToSystem>fade</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>
</themeCapabilities>
