<?xml version="1.0" encoding="UTF-8"?>
<!--
  RASPBERRY CIRCUIT - an animated EmulationStation theme for Batocera
  ==================================================================
  How to read this file (it's just like HTML):
    <tag> ... </tag>   = an element, same idea as <div> ... </div>
    pos / size         = numbers from 0 to 1 = a fraction of the screen
                         (0.5 = halfway). "0.5 0.5" is the screen centre.
    origin             = which point of the element "pos" refers to
                         (0 0 = top-left corner, 0.5 0.5 = its centre)
    colors             = 6-digit hex WITHOUT the # (C51A4A = raspberry)
    zIndex             = layering. Higher numbers draw on top.
-->
<theme>
  <formatVersion>7</formatVersion>

  <!-- ===================== SYSTEM (main) SCREEN ===================== -->
  <view name="system">

    <!-- Static picture shown behind the video (also the fallback
         if your device can't play the video) -->
    <image name="bg_still" extra="true">
      <path>./art/background.jpg</path>
      <pos>0 0</pos>
      <size>1 1</size>
      <zIndex>0</zIndex>
    </image>

    <!-- THE ANIMATION: looping circuit-board video -->
    <video name="bg_video" extra="true">
      <path>./art/background.mp4</path>
      <pos>0 0</pos>
      <size>1 1</size>
      <delay>0</delay>
      <zIndex>1</zIndex>
    </video>

    <!-- Top header bar -->
    <image name="header_bar" extra="true">
      <path>./art/panel.png</path>
      <pos>0 0</pos>
      <size>1 0.12</size>
      <zIndex>10</zIndex>
      <storyboard>
        <animation property="y" from="-0.12" to="0" duration="450" mode="EaseOutCubic"/>
      </storyboard>
    </image>
    <image name="header_line" extra="true">
      <path>./art/accent.png</path>
      <pos>0 0.12</pos>
      <size>1 0.006</size>
      <zIndex>11</zIndex>
    </image>
    <image name="berry" extra="true">
      <path>./art/berry.png</path>
      <pos>0.053 0.06</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.09 0.1</maxSize>
      <zIndex>12</zIndex>
      <storyboard>
        <animation property="scale" from="1" to="1.1" duration="900" autoReverse="true" repeat="forever" mode="EaseInOut"/>
        <animation property="rotation" from="-4" to="4" duration="1800" autoReverse="true" repeat="forever" mode="EaseInOut"/>
      </storyboard>
    </image>
    <!-- Board LEDs: PWR stays lit, ACT blinks -->
    <image name="led_pwr" extra="true">
      <path>./art/led_red.png</path>
      <pos>0.095 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.03 0.06</maxSize>
      <zIndex>12</zIndex>
    </image>
    <image name="led_act" extra="true">
      <path>./art/led_green.png</path>
      <pos>0.125 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.03 0.06</maxSize>
      <zIndex>12</zIndex>
      <storyboard>
        <animation property="opacity" from="1" to="0.08" begin="0" duration="90" autoReverse="true" repeat="forever" mode="Linear"/>
      </storyboard>
    </image>
    <text name="title" extra="true">
      <text>BERRY BOX</text>
      <pos>0.17 0.06</pos>
      <origin>0 0.5</origin>
      <size>0.5 0.08</size>
      <fontPath>./art/fonts/DejaVuSansMono-Bold.ttf</fontPath>
      <fontSize>0.05</fontSize>
      <color>FFFFFF</color>
      <alignment>left</alignment>
      <zIndex>12</zIndex>
    </text>

    <!-- Dark strip behind the carousel so it stays readable over the photo -->
    <image name="carousel_band" extra="true">
      <path>./art/panel.png</path>
      <color>FFFFFFEE</color>
      <pos>0 0.42</pos>
      <size>1 0.32</size>
      <zIndex>30</zIndex>
    </image>
    <image name="carousel_line_top" extra="true">
      <path>./art/accent.png</path>
      <pos>0 0.42</pos>
      <size>1 0.003</size>
      <zIndex>31</zIndex>
    </image>
    <image name="carousel_line_bottom" extra="true">
      <path>./art/accent_green.png</path>
      <pos>0 0.737</pos>
      <size>1 0.003</size>
      <zIndex>31</zIndex>
    </image>

    <!-- Console picture for each system (art/systems/<system>.png) -->
    <image name="logo">
      <path>./art/systems/${system.theme}.png</path>
    </image>

    <!-- The row of systems you scroll through -->
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.58</pos>
      <size>1 0.30</size>
      <origin>0 0.5</origin>
      <logoSize>0.22 0.22</logoSize>
      <logoScale>1.25</logoScale>
      <maxLogoCount>3</maxLogoCount>
      <color>00000000</color>
      <zIndex>50</zIndex>
    </carousel>

    <!-- System name, used when a system has no logo image -->
    <text name="logoText">
      <fontPath>./art/fonts/DejaVuSansMono-Bold.ttf</fontPath>
      <fontSize>0.07</fontSize>
      <color>FFFFFF</color>
      <alignment>center</alignment>
      <storyboard event="activate">
        <animation property="scale" from="0.85" to="1" duration="300" mode="EaseOutCubic"/>
        <animation property="opacity" from="0.4" to="1" duration="300" mode="Linear"/>
      </storyboard>
    </text>

    <!-- "123 games available" line -->
    <image name="info_bar" extra="true">
      <path>./art/panel.png</path>
      <pos>0.5 0.885</pos>
      <origin>0.5 0.5</origin>
      <size>0.42 0.07</size>
      <zIndex>40</zIndex>
      <storyboard>
        <animation property="opacity" from="0" to="1" begin="300" duration="500" mode="Linear"/>
      </storyboard>
    </image>
    <text name="systemInfo">
      <pos>0.5 0.885</pos>
      <origin>0.5 0.5</origin>
      <size>0.42 0.07</size>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.03</fontSize>
      <color>B8D8B0</color>
      <alignment>center</alignment>
      <zIndex>50</zIndex>
    </text>

    <helpsystem name="help">
      <pos>0.5 0.96</pos>
      <origin>0.5 0.5</origin>
      <textColor>B8D8B0</textColor>
      <iconColor>C51A4A</iconColor>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.022</fontSize>
      <zIndex>60</zIndex>
    </helpsystem>
  </view>

  <!-- ===================== GAME LIST SCREENS ===================== -->
  <view name="basic, detailed, video">

    <image name="bg_still" extra="true">
      <path>./art/background.jpg</path>
      <pos>0 0</pos>
      <size>1 1</size>
      <zIndex>0</zIndex>
    </image>
    <video name="bg_video" extra="true">
      <path>./art/background.mp4</path>
      <pos>0 0</pos>
      <size>1 1</size>
      <delay>0</delay>
      <zIndex>1</zIndex>
    </video>

    <image name="header_bar" extra="true">
      <path>./art/panel.png</path>
      <pos>0 0</pos>
      <size>1 0.12</size>
      <zIndex>10</zIndex>
      <storyboard>
        <animation property="y" from="-0.12" to="0" duration="450" mode="EaseOutCubic"/>
      </storyboard>
    </image>
    <image name="header_line" extra="true">
      <path>./art/accent.png</path>
      <pos>0 0.12</pos>
      <size>1 0.006</size>
      <zIndex>11</zIndex>
    </image>
    <image name="berry" extra="true">
      <path>./art/berry.png</path>
      <pos>0.053 0.06</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.09 0.1</maxSize>
      <zIndex>12</zIndex>
      <storyboard>
        <animation property="scale" from="1" to="1.1" duration="900" autoReverse="true" repeat="forever" mode="EaseInOut"/>
        <animation property="rotation" from="-4" to="4" duration="1800" autoReverse="true" repeat="forever" mode="EaseInOut"/>
      </storyboard>
    </image>
    <!-- Board LEDs: PWR stays lit, ACT blinks -->
    <image name="led_pwr" extra="true">
      <path>./art/led_red.png</path>
      <pos>0.095 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.03 0.06</maxSize>
      <zIndex>12</zIndex>
    </image>
    <image name="led_act" extra="true">
      <path>./art/led_green.png</path>
      <pos>0.125 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.03 0.06</maxSize>
      <zIndex>12</zIndex>
      <storyboard>
        <animation property="opacity" from="1" to="0.08" begin="0" duration="90" autoReverse="true" repeat="forever" mode="Linear"/>
      </storyboard>
    </image>

    <!-- System logo (or name) in the header -->
    <image name="logo">
      <path>./art/systems/${system.theme}.png</path>
      <pos>0.17 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.07 0.1</maxSize>
      <zIndex>12</zIndex>
    </image>
    <text name="md_systemname" extra="true">
      <pos>0.25 0.06</pos>
      <origin>0 0.5</origin>
      <size>0.5 0.08</size>
      <fontPath>./art/fonts/DejaVuSansMono-Bold.ttf</fontPath>
      <fontSize>0.045</fontSize>
      <color>FFFFFF</color>
      <alignment>left</alignment>
      <zIndex>12</zIndex>
    </text>

    <!-- Left panel behind the game list -->
    <image name="list_panel" extra="true">
      <path>./art/panel.png</path>
      <pos>0.03 0.16</pos>
      <size>0.47 0.66</size>
      <zIndex>10</zIndex>
      <storyboard>
        <animation property="x" from="-0.5" to="0.03" begin="150" duration="500" mode="EaseOutCubic"/>
        <animation property="opacity" from="0" to="1" begin="150" duration="500" mode="Linear"/>
      </storyboard>
    </image>
    <image name="list_edge" extra="true">
      <path>./art/accent_green.png</path>
      <pos>0.03 0.16</pos>
      <size>0.004 0.66</size>
      <zIndex>11</zIndex>
    </image>

    <textlist name="gamelist">
      <pos>0.04 0.17</pos>
      <size>0.45 0.64</size>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.032</fontSize>
      <lineSpacing>1.3</lineSpacing>
      <primaryColor>B8D8B0</primaryColor>
      <secondaryColor>7FA37A</secondaryColor>
      <selectedColor>FFFFFF</selectedColor>
      <selectorColor>C51A4A</selectorColor>
      <selectorColorEnd>8E1237</selectorColorEnd>
      <horizontalMargin>0.01</horizontalMargin>
      <alignment>left</alignment>
      <zIndex>20</zIndex>
    </textlist>

    <!-- Right side: picture/video + description -->
    <image name="media_panel" extra="true">
      <path>./art/panel.png</path>
      <pos>0.53 0.16</pos>
      <size>0.44 0.66</size>
      <zIndex>10</zIndex>
      <storyboard>
        <animation property="x" from="1" to="0.53" begin="250" duration="500" mode="EaseOutCubic"/>
        <animation property="opacity" from="0" to="1" begin="250" duration="500" mode="Linear"/>
      </storyboard>
    </image>
    <image name="media_edge" extra="true">
      <path>./art/accent.png</path>
      <pos>0.53 0.16</pos>
      <size>0.44 0.005</size>
      <zIndex>11</zIndex>
    </image>

    <image name="md_image">
      <pos>0.75 0.35</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.40 0.32</maxSize>
      <zIndex>20</zIndex>
      <storyboard>
        <animation property="opacity" from="0" to="1" duration="300" mode="Linear"/>
        <animation property="scale" from="0.94" to="1" duration="300" mode="EaseOut"/>
      </storyboard>
    </image>
    <video name="md_video">
      <pos>0.75 0.35</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.40 0.32</maxSize>
      <delay>1.5</delay>
      <zIndex>21</zIndex>
    </video>

    <rating name="md_rating">
      <pos>0.55 0.55</pos>
      <size>0.12 0.03</size>
      <color>FFFFFF</color>
      <zIndex>20</zIndex>
    </rating>
    <datetime name="md_releasedate">
      <pos>0.955 0.55</pos>
      <origin>1 0</origin>
      <size>0.2 0.035</size>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.024</fontSize>
      <color>B8D8B0</color>
      <alignment>right</alignment>
      <zIndex>20</zIndex>
    </datetime>

    <text name="md_description">
      <pos>0.55 0.60</pos>
      <size>0.40 0.21</size>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.024</fontSize>
      <lineSpacing>1.2</lineSpacing>
      <color>E4F2DF</color>
      <alignment>left</alignment>
      <zIndex>20</zIndex>
    </text>

    <helpsystem name="help">
      <pos>0.5 0.96</pos>
      <origin>0.5 0.5</origin>
      <textColor>B8D8B0</textColor>
      <iconColor>C51A4A</iconColor>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.022</fontSize>
      <zIndex>60</zIndex>
    </helpsystem>
  </view>

  <!-- ===================== GRID VIEW (simple) ===================== -->
  <view name="grid">
    <image name="bg_still" extra="true">
      <path>./art/background.jpg</path>
      <pos>0 0</pos>
      <size>1 1</size>
      <zIndex>0</zIndex>
    </image>
    <video name="bg_video" extra="true">
      <path>./art/background.mp4</path>
      <pos>0 0</pos>
      <size>1 1</size>
      <delay>0</delay>
      <zIndex>1</zIndex>
    </video>
    <image name="header_bar" extra="true">
      <path>./art/panel.png</path>
      <pos>0 0</pos>
      <size>1 0.12</size>
      <zIndex>10</zIndex>
      <storyboard>
        <animation property="y" from="-0.12" to="0" duration="450" mode="EaseOutCubic"/>
      </storyboard>
    </image>
    <image name="header_line" extra="true">
      <path>./art/accent.png</path>
      <pos>0 0.12</pos>
      <size>1 0.006</size>
      <zIndex>11</zIndex>
    </image>
    <image name="berry" extra="true">
      <path>./art/berry.png</path>
      <pos>0.053 0.06</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.09 0.1</maxSize>
      <zIndex>12</zIndex>
      <storyboard>
        <animation property="scale" from="1" to="1.1" duration="900" autoReverse="true" repeat="forever" mode="EaseInOut"/>
        <animation property="rotation" from="-4" to="4" duration="1800" autoReverse="true" repeat="forever" mode="EaseInOut"/>
      </storyboard>
    </image>
    <!-- Board LEDs: PWR stays lit, ACT blinks -->
    <image name="led_pwr" extra="true">
      <path>./art/led_red.png</path>
      <pos>0.095 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.03 0.06</maxSize>
      <zIndex>12</zIndex>
    </image>
    <image name="led_act" extra="true">
      <path>./art/led_green.png</path>
      <pos>0.125 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.03 0.06</maxSize>
      <zIndex>12</zIndex>
      <storyboard>
        <animation property="opacity" from="1" to="0.08" begin="0" duration="90" autoReverse="true" repeat="forever" mode="Linear"/>
      </storyboard>
    </image>
    <gamegrid name="gamegrid">
      <pos>0.03 0.16</pos>
      <size>0.94 0.66</size>
      <margin>0.02 0.02</margin>
      <zIndex>20</zIndex>
    </gamegrid>
    <helpsystem name="help">
      <pos>0.5 0.96</pos>
      <origin>0.5 0.5</origin>
      <textColor>B8D8B0</textColor>
      <iconColor>C51A4A</iconColor>
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <fontSize>0.022</fontSize>
      <zIndex>60</zIndex>
    </helpsystem>
  </view>

  <!-- ===================== MENUS ===================== -->
  <view name="menu">
    <menuBackground name="menubg">
      <color>0B1A10</color>
    </menuBackground>
    <menuText name="menutext">
      <fontPath>./art/fonts/DejaVuSans.ttf</fontPath>
      <color>B8D8B0</color>
      <selectedColor>FFFFFF</selectedColor>
      <selectorColor>C51A4A</selectorColor>
      <separatorColor>2E5A34</separatorColor>
    </menuText>
  </view>
</theme>
